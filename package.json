{
  "name": "rospartner-ai-unica-ops",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "Unica ops — операционный микросервис платформы (сервис #19 целевой карты). Первый модуль: janitor (retention PG/MinIO/Qdrant). Далее: notify (SMTP), maintenance, admin-analytics.",
  "scripts": {
    "check": "tsc",
    "test": "vitest run",
    "dev": "tsx watch server/janitor-runtime-entry.ts",
    "build": "esbuild server/janitor-runtime-entry.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/janitor-runtime-entry.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@neondatabase/serverless": "^0.10.4",
    "@qdrant/js-client-rest": "^1.15.1",
    "@smithy/node-http-handler": "^4.6.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "express": "^4.22.2",
    "ioredis": "^5.9.2",
    "node-cache": "^5.1.2",
    "pg": "^8.16.3",
    "pino": "^10.2.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.30",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
